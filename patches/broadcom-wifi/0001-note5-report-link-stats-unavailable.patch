diff --git a/bcmdhd/wifi_hal/note5_wifi_features.h b/bcmdhd/wifi_hal/note5_wifi_features.h
new file mode 100644
--- /dev/null
+++ b/bcmdhd/wifi_hal/note5_wifi_features.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <string.h>
+
+// This legacy BCM4358 driver advertises link-layer statistics but returns no
+// usable vendor data. Let Android use its existing packet-counter fallback.
+// Other boards and all other capabilities retain the firmware's feature mask.
+inline feature_set note5_wifi_features(feature_set features, const char* hardware) {
+    if (hardware != nullptr && strcmp(hardware, "samsungexynos7420") == 0)
+        return features & ~static_cast<feature_set>(WIFI_FEATURE_LINK_LAYER_STATS);
+    return features;
+}
