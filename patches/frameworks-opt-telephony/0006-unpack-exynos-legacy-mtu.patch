+    /** Decode the Exynos7420 vendor bridge's IPv4 | (IPv6 << 16) legacy HAL field. */
+    @VisibleForTesting
+    static int[] decodeLegacySamsungMtu(int rawMtu, boolean legacyExynos) {
+        int ipv4 = rawMtu & 0xffff;
+        int ipv6 = rawMtu >>> 16;
+        // An ordinary single MTU, an unknown value and other radios retain existing semantics.
+        if (!legacyExynos || rawMtu <= 0 || ipv6 == 0
+                || ipv6 < 1280 || ipv6 > 10000
+                || (ipv4 != 0 && (ipv4 < 68 || ipv4 > 10000))) {
+            return new int[] {rawMtu, rawMtu, rawMtu};
+        }
+        return new int[] {Math.max(ipv4, ipv6), ipv4, ipv6};
+    }
