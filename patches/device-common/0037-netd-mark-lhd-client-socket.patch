diff --git a/sepolicy/vendor/lhd.te b/sepolicy/vendor/lhd.te
--- a/sepolicy/vendor/lhd.te
+++ b/sepolicy/vendor/lhd.te
@@ -30,3 +30,7 @@
 
 # fwmarkd receives the client socket over SCM_RIGHTS before setting its mark.
 allow netd lhd:fd use;
+
+# Receiving the descriptor also checks its socket access modes; fwmarkd then
+# reads/writes SO_MARK. Limit this to the observed lhd TCP client socket.
+allow netd lhd:tcp_socket { read write getopt setopt };
