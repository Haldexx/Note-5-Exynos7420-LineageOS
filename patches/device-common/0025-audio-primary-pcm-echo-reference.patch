+/* Recording threads created after an output patch can have no cached output
+ * device. The legacy preprocessor still needs the real route to choose speaker
+ * versus earpiece tuning. Refresh it when capture starts, including route restarts.
+ */
+static void set_preprocessor_output_device(struct stream_in *in)
+{
+    struct stream_out *out = in->dev->primary_output;
+    uint32_t device;
+    int i, configured = 0;
+    if (out == NULL || out->standby)
+        return;
+    device = out->devices;
+    if (device == AUDIO_DEVICE_NONE)
+        return;
+    for (i = 0; i < in->num_preprocessors; i++) {
+        effect_handle_t effect = in->preprocessors[i].effect_itfe;
+        effect_descriptor_t desc;
+        int reply = 0;
+        uint32_t size = sizeof(reply);
+        if ((*effect)->get_descriptor(effect, &desc) != 0 ||
+            (desc.flags & EFFECT_FLAG_DEVICE_MASK) != EFFECT_FLAG_DEVICE_IND)
+            continue;
+        int status = (*effect)->command(effect, EFFECT_CMD_SET_DEVICE,
+                sizeof(device), &device, &size, &reply);
+        if (status == 0 && reply == 0)
+            configured++;
+        else
+            ALOGW("Voice preprocessor device update failed: %d/%d", status, reply);
+    }
+    ALOGI("Voice preprocessor output device=%#x configured=%d", device, configured);
+}
