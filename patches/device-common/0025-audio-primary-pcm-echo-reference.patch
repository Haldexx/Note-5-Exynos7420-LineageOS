+/* Only the primary PCM stream owns the playback reference. Android 16
+ * opens it with PRIMARY|DEEP_BUFFER, which is also used for software IMS calls.
+ * Secondary/fast/offload streams must neither feed nor release this reference.
+ */
+static bool is_echo_reference_output(const struct audio_device *adev,
+                                     const struct stream_out *out)
+{
+    return out != NULL && out == adev->primary_output &&
+           (out->usecase == USECASE_AUDIO_PLAYBACK ||
+            out->usecase == USECASE_AUDIO_PLAYBACK_DEEP_BUFFER);
+}
