+bool camera60_backport_available() {
+    if(sizeof(void*)!=4) return false;
+    void *lib=dlopen("libexynoscamera3.so",RTLD_NOW|RTLD_NOLOAD);
+    if(!lib) return false;
+    auto fn=dlsym(lib,"_ZN7android13ExynosCamera316configureStreamsEP28camera3_stream_configuration");
+    auto lut=dlsym(lib,"_ZN7android22ExynosCameraParameters20m_getPreviewSizeListEPi");
+    auto selector=dlsym(lib,"_ZN7android22ExynosCameraParameters16setHighSpeedModeEj");
+    auto code=reinterpret_cast<unsigned char*>(reinterpret_cast<uintptr_t>(fn)&~1u);
+    auto table=reinterpret_cast<unsigned char*>(reinterpret_cast<uintptr_t>(lut)&~1u);
+    auto nativeMode=reinterpret_cast<unsigned char*>(reinterpret_cast<uintptr_t>(selector)&~1u);
+    const unsigned char prefix[]={0x2d,0xe9,0xf0,0x4f,0xad,0xb0,0x80,0x46};
+    const unsigned char mode[]={0x02,0x21,0xf9,0xf7,0x15,0xfd};
+    const unsigned char branch[]={0x00,0x28,0x6b,0xd0,0x52,0xe0};
+    const unsigned char nativePrefix[]={0x4f,0xf4,0xf8,0x42,0x83,0x58,0x02,0x29,
+        0x04,0xbf,0x47,0xf6,0xc0,0x32,0x81,0x58};
+    bool available=fn && lut && selector && !memcmp(nativeMode,nativePrefix,16) && !memcmp(code,prefix,8) &&
+        !memcmp(code+0xbc,mode,6) && !memcmp(table+0x40,branch,6);
+    dlclose(lib);
+    return available;
+}
+
+static const camera_metadata_t *camera60_characteristics(const camera_metadata_t *original) {
+    static android::Mutex lock;
+    static camera_metadata_t *cached=nullptr;
+    android::Mutex::Autolock held(lock);
+    if(cached) return cached;
+    android::CameraMetadata data(clone_camera_metadata(original));
+    auto ranges=data.find(ANDROID_CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES);
+    std::vector<int32_t> fps(ranges.data.i32,ranges.data.i32+ranges.count);
+    fps.insert(fps.end(),{30,60,60,60});
+    data.update(ANDROID_CONTROL_AE_AVAILABLE_TARGET_FPS_RANGES,fps.data(),fps.size());
+    auto keys=data.find(ANDROID_REQUEST_AVAILABLE_SESSION_KEYS);
+    std::vector<int32_t> session;
+    if(keys.count) session.assign(keys.data.i32,keys.data.i32+keys.count);
+    if(std::find(session.begin(),session.end(),ANDROID_CONTROL_AE_TARGET_FPS_RANGE)==session.end())
+        session.push_back(ANDROID_CONTROL_AE_TARGET_FPS_RANGE);
+    data.update(ANDROID_REQUEST_AVAILABLE_SESSION_KEYS,session.data(),session.size());
+    auto characteristics=data.find(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS);
+    std::vector<int32_t> names(characteristics.data.i32,characteristics.data.i32+characteristics.count);
+    if(std::find(names.begin(),names.end(),ANDROID_REQUEST_AVAILABLE_SESSION_KEYS)==names.end())
+        names.push_back(ANDROID_REQUEST_AVAILABLE_SESSION_KEYS);
+    data.update(ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS,names.data(),names.size());
+    auto duration=data.find(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS);
+    std::vector<int64_t> durations(duration.data.i64,duration.data.i64+duration.count);
+    for(size_t i=0;i+3<durations.size();i+=4) {
+        if(durations[i+1]<=1920 && durations[i+2]<=1080 &&
+           durations[i]!=HAL_PIXEL_FORMAT_BLOB) durations[i+3]=16666667;
+    }
+    data.update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,durations.data(),durations.size());
+    cached=data.release();
+    return cached;
+}
