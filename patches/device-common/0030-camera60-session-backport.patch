+// Session-parameter candidate; activates only with the matching native backport.
+static bool session60_prepare(const camera3_device *device, camera3_stream_configuration_t *streams) {
+
+    if (CAMERA_ID(device) != 0 || !camera60_backport_available()) return false;
+    camera_metadata_ro_entry fps;
+    bool desired60=streams->session_parameters &&
+        find_camera_metadata_ro_entry(streams->session_parameters,ANDROID_CONTROL_AE_TARGET_FPS_RANGE,&fps)==0 &&
+        fps.count==2 && fps.data.i32[1]==60;
+    int desiredMode=desired60?1:(streams->operation_mode==1?2:0);
+
+    int width = 0, height = 0;
+    for (unsigned int i = 0; i < streams->num_streams; ++i) {
+        auto s = streams->streams[i];
+        if (desiredMode && (s->width > 1920 || s->height > 1080)) return false;
+        if (s->width > static_cast<unsigned int>(width)) { width=s->width; height=s->height; }
+    }
+    void *lib=dlopen("libexynoscamera3.so", RTLD_NOW | RTLD_NOLOAD);
+    if (!lib) return false;
+    auto configure=dlsym(lib,"_ZN7android13ExynosCamera316configureStreamsEP28camera3_stream_configuration");
+    const unsigned char prefix[]={0x2d,0xe9,0xf0,0x4f,0xad,0xb0,0x80,0x46};
+    if (!configure || memcmp(reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(configure)&~1u),prefix,sizeof(prefix))) {
+        ALOGE("camera60-session: unsupported blob"); dlclose(lib); return false;
+    }
+    auto vendor=reinterpret_cast<wrapper_camera3_device_t*>(const_cast<camera3_device*>(device))->vendor;
+    void *p=*reinterpret_cast<void**>(static_cast<unsigned char*>(vendor->priv)+0x14);
+    using GetConfig=void*(*)(void*);
+    using Check=int(*)(void*,const android::CameraParameters&);
+    using SetSamsung=void(*)(void*,bool);
+    using SetMode=void(*)(void*,unsigned int);
+    using GetInt=int(*)(void*);
+    using GetTable=int*(*)(void*,int);
+    auto config=reinterpret_cast<GetConfig>(dlsym(lib,"_ZN7android22ExynosCameraParameters9getConfigEv"));
+    auto hint=reinterpret_cast<Check>(dlsym(lib,"_ZN7android22ExynosCameraParameters18checkRecordingHintERKNS_16CameraParametersE"));
+    auto video=reinterpret_cast<Check>(dlsym(lib,"_ZN7android22ExynosCameraParameters14checkVideoSizeERKNS_16CameraParametersE"));
+    auto fast=reinterpret_cast<Check>(dlsym(lib,"_ZN7android22ExynosCameraParameters16checkFastFpsModeERKNS_16CameraParametersE"));
+    auto preview=reinterpret_cast<Check>(dlsym(lib,"_ZN7android22ExynosCameraParameters16checkPreviewSizeERKNS_16CameraParametersE"));
+    auto samsung=reinterpret_cast<SetSamsung>(dlsym(lib,"_ZN7android22ExynosCameraParameters16setSamsungCameraEb"));
+    auto mode=reinterpret_cast<SetMode>(dlsym(lib,"_ZN7android22ExynosCameraParameters16setHighSpeedModeEj"));
+    auto getMode=reinterpret_cast<GetInt>(dlsym(lib,"_ZN7android22ExynosCameraParameters13getConfigModeEv"));
+    auto table=reinterpret_cast<GetTable>(dlsym(lib,"_ZN7android22ExynosCameraParameters21getHighSpeedSizeTableEi"));
+    if (p && config && hint && video && fast && preview && samsung && mode && getMode && table) {
+
+        int previousMode=getMode(p);
+        if(desiredMode==0 && previousMode==0) { dlclose(lib); return false; }
+        auto c=static_cast<unsigned char*>(config(p));
+        // Disassembled 32-bit ExynosConfigInfo: pointer + four 0x3a4-byte mode blocks.
+        memcpy(c+0x3a8,c+0x74c,0x3a4);
+        android::CameraParameters settings;
+        settings.set("recording-hint","true");
+        settings.set("fast-fps-mode",desiredMode);
+        settings.setVideoSize(width,height);
+        settings.setPreviewSize(width,height);
+        settings.set("preview-fps-range",desired60?"60000,60000":desiredMode?"120000,120000":"30000,30000");
+        settings.setPreviewFrameRate(desired60?60:desiredMode?120:30);
+        samsung(p,true);
+        int h=hint(p,settings),v=video(p,settings);
+        if(desiredMode!=2) mode(p,desiredMode);
+        int f=fast(p,settings),pr=preview(p,settings);
+        mode(p,desiredMode);
+
+        auto setfile=reinterpret_cast<void(*)(void*)>(dlsym(lib,"_ZN7android22ExynosCameraParameters20checkSetfileYuvRangeEv"));
+        if(setfile) setfile(p);
+        auto lut=table(p,desiredMode);
+        ALOGI("camera60-session: %dx%d hint=%d video=%d fast=%d preview=%d mode=%d lut=%p",
+                width,height,h,v,f,pr,getMode(p),lut);
+        if(lut) ALOGI("camera60-session: lut %d %d %d %d %d %d %d %d %d %d %d",
+                lut[0],lut[1],lut[2],lut[3],lut[4],lut[5],lut[6],lut[7],lut[8],lut[9],lut[10]);
+        if(lut) {
+            using SetSize=void(*)(void*,int,int);
+            using Update=void(*)(void*);
+            auto sensor=reinterpret_cast<SetSize>(dlsym(lib,"_ZN7android22ExynosCameraParameters17m_setHwSensorSizeEii"));
+            auto hwPreview=reinterpret_cast<SetSize>(dlsym(lib,"_ZN7android22ExynosCameraParameters18m_setHwPreviewSizeEii"));
+            auto bns=reinterpret_cast<SetSize>(dlsym(lib,"_ZN7android22ExynosCameraParameters10setBnsSizeEii"));
+            auto binning=reinterpret_cast<Update>(dlsym(lib,"_ZN7android22ExynosCameraParameters23updateBinningScaleRatioEv"));
+            auto bnsRatio=reinterpret_cast<Update>(dlsym(lib,"_ZN7android22ExynosCameraParameters19updateBnsScaleRatioEv"));
+            if(sensor && hwPreview && bns && binning && bnsRatio) {
+                sensor(p,lut[1],lut[2]); hwPreview(p,lut[7],lut[8]);
+                bns(p,lut[3],lut[4]); binning(p); bnsRatio(p);
+            } else ALOGE("camera60-session: missing size setter");
+        }
+
+        auto restoreMode=reinterpret_cast<SetMode>(dlsym(lib,"_ZN7android22ExynosCameraParameters13setConfigModeEj"));
+        if(restoreMode) restoreMode(p,previousMode);
+    } else ALOGE("camera60-session: missing diagnostic symbol");
+    dlclose(lib);
+    return desired60;
+}
