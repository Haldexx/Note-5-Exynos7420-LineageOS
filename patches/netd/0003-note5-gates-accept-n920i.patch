Subject: [PATCH] Note 5 device gates also accept the SM-N920I (nobleltedv)

The legacy-BPF networking and offline fallbacks were confined to ro.product.device
"nobleltespr". The SM-N920I build (lineage_nobleltedv) runs the same 3.10 kernel and
must take the same paths; otherwise NetBpfLoad refuses the kernel and init reboots
(reboot,bpfloader-failed). Only the two Note 5 products are accepted.

diff --git a/server/BandwidthController.cpp b/server/BandwidthController.cpp
--- a/server/BandwidthController.cpp
+++ b/server/BandwidthController.cpp
@@ -205,7 +205,8 @@
 static bool isOfflineBootTest() {
     const auto buildType = android::base::GetProperty("ro.build.type", "");
     if ((buildType != "userdebug" && buildType != "eng") ||
-        android::base::GetProperty("ro.product.device", "") != "nobleltespr") {
+        (android::base::GetProperty("ro.product.device", "") != "nobleltespr" &&
+         android::base::GetProperty("ro.product.device", "") != "nobleltedv")) {
         return false;
     }
     // Offline boot mode, or legacy capability mode whose loader did not verify/load BPF.
diff --git a/server/NetdNativeService.cpp b/server/NetdNativeService.cpp
--- a/server/NetdNativeService.cpp
+++ b/server/NetdNativeService.cpp
@@ -70,7 +70,8 @@
 static bool isOfflineBootTest() {
     const auto buildType = android::base::GetProperty("ro.build.type", "");
     if ((buildType != "userdebug" && buildType != "eng") ||
-        android::base::GetProperty("ro.product.device", "") != "nobleltespr") {
+        (android::base::GetProperty("ro.product.device", "") != "nobleltespr" &&
+         android::base::GetProperty("ro.product.device", "") != "nobleltedv")) {
         return false;
     }
     // Offline boot mode, or legacy capability mode whose loader did not verify/load BPF.
