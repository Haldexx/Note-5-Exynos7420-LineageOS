+    if (isOfflineBootTest()) {
+        // No pinned BPF programs exist in offline boot mode. Keep loopback working,
+        // and block IPv4/IPv6 traffic before any other controller's accept rules.
+        // The caller applies this to both families and treats installation failure
+        // as fatal, just as it does for the normal accounting rules.
