 /**
  * MMS HTTP client for sending and downloading MMS messages
@@ -134,7 +143,16 @@
             final URL url = new URL(urlString);
             maybeWaitForIpv4(requestId, url);
             // Now get the connection
-            connection = (HttpURLConnection) mNetwork.openConnection(url, proxy);
+            final int carrierTimeout = mmsConfig.getInt(SmsManager.MMS_CONFIG_HTTP_SOCKET_TIMEOUT);
+            final int writeTimeout = carrierTimeout > 0 ? carrierTimeout : 60000;
+            // URLConnection has no write-timeout setter. Its Android handler leaves writes
+            // infinite, so a stalled large POST can hold the MMS bearer indefinitely.
+            // Keep both DNS and sockets on the carrier network, including private-DNS bypass.
+            final HttpURLConnectionFactory factory = HttpURLConnectionFactory.createInstance();
+            factory.setDns(hostname -> Arrays.asList(mNetwork.getAllByName(hostname)));
+            factory.setNewConnectionPool(0, 1, TimeUnit.MINUTES);
+            connection = (HttpURLConnection) factory.openConnection(url,
+                    new WriteTimeoutSocketFactory(mNetwork.getSocketFactory(), writeTimeout), proxy);
             connection.setDoInput(true);
             connection.setConnectTimeout(
                     mmsConfig.getInt(SmsManager.MMS_CONFIG_HTTP_SOCKET_TIMEOUT));
