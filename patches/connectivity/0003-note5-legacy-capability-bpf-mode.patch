+// Proves, on the running kernel, the interfaces the 4.9-level program set needs.
+static bool legacyCapabilitiesVerified() {
+    if (isKernel32Bit()) {
+        ALOGE("NOTE 5 LEGACY BPF: 64-bit kernel required");
+        return false;
+    }
+    const struct {
+        enum bpf_map_type type;
+        uint32_t key_size;
+        uint32_t map_flags;
+    } maps[] = {
+        {BPF_MAP_TYPE_HASH, sizeof(uint32_t), 0},
+        {BPF_MAP_TYPE_ARRAY, sizeof(uint32_t), 0},
+        {BPF_MAP_TYPE_LPM_TRIE, 2 * sizeof(uint32_t), BPF_F_NO_PREALLOC},
+    };
+    for (const auto& m : maps) {
+        unique_fd fd(createMap(m.type, m.key_size, sizeof(uint32_t), 2, m.map_flags));
+        if (!fd.ok()) {
+            ALOGE("NOTE 5 LEGACY BPF: map type %d unavailable [%d:%s]", m.type, errno,
+                  strerror(errno));
+            return false;
+        }
+    }
+    const struct bpf_insn insns[] = {
+        {.code = BPF_ALU64 | BPF_MOV | BPF_K, .dst_reg = BPF_REG_0, .imm = 1},
+        {.code = BPF_JMP | BPF_EXIT},
+    };
+    static const char license[] = "Apache 2.0";
+    const struct {
+        enum bpf_prog_type type;
+        enum bpf_attach_type attach;
+    } progs[] = {
+        {BPF_PROG_TYPE_SOCKET_FILTER, static_cast<enum bpf_attach_type>(0)},
+        {BPF_PROG_TYPE_SCHED_CLS, static_cast<enum bpf_attach_type>(0)},
+        {BPF_PROG_TYPE_SCHED_ACT, static_cast<enum bpf_attach_type>(0)},
+        {BPF_PROG_TYPE_CGROUP_SKB, BPF_CGROUP_INET_INGRESS},
+        {BPF_PROG_TYPE_CGROUP_SKB, BPF_CGROUP_INET_EGRESS},
+    };
+    for (const auto& p : progs) {
+        union bpf_attr req = {
+            .prog_type = p.type,
+            .insn_cnt = 2,
+            .insns = ptr_to_u64(insns),
+            .license = ptr_to_u64(license),
+            .expected_attach_type = p.attach,
+        };
+        unique_fd fd(bpf(BPF_PROG_LOAD, req));
+        if (!fd.ok()) {
+            ALOGE("NOTE 5 LEGACY BPF: program type %d (attach %d) unavailable [%d:%s]", p.type,
+                  p.attach, errno, strerror(errno));
+            return false;
+        }
+    }
+    return true;
+}
