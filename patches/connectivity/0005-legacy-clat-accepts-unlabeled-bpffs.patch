     if (v < 0) ALOGF("lgetxattr '%s' errno=%d", path, errno);
-    if (strncmp(ctxt, b, sizeof(b))) ALOGF("context of '%s' is '%s' != '%s'", path, b, ctxt);
+    if (strncmp(ctxt, b, sizeof(b))) {
+        // A 3.10 kernel without per-file bpffs genfs labels (kernel patch 0013) gives every
+        // object the bpffs root label. Accept only that, only in Note 5 legacy mode.
+        if (!strncmp("u:object_r:fs_bpf:s0", b, sizeof(b)) && isNote5LegacyBpfActive()) {
+            ALOGE("NOTE 5 LEGACY BPF: '%s' has the bpffs root label, expected '%s'", path, ctxt);
+        } else {
