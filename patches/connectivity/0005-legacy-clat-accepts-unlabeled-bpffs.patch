+// Note 5 legacy capability mode whose loader verified and loaded the BPF programs.
+static bool isNote5LegacyBpfActive() {
+    const auto buildType = android::base::GetProperty("ro.build.type", "");
+    return (buildType == "userdebug" || buildType == "eng") &&
+           android::base::GetProperty("ro.product.device", "") == "nobleltespr" &&
+           android::base::GetBoolProperty("ro.note5.legacy_bpf", false) &&
+           android::base::GetBoolProperty("bpf.note5.legacy_active", false);
+}
+
 static bool fatal = false;
 
 #define ALOGF(s ...) do { ALOGE(s); fatal = true; } while(0)
@@ -84,7 +93,15 @@
     char b[255] = {};
