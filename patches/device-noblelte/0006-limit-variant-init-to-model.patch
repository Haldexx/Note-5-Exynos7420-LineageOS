-    std::string bootloader = GetProperty("ro.bootloader", "");
+    // This unified product's boot identity, fingerprints and modem defaults
+    // belong to its build configuration. Detect only the hardware model here:
+    // restoring the entire legacy hook changed those working defaults as well.
