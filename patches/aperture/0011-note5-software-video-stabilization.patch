+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.aperture.stabilization;
+
+import java.util.Arrays;
+
+/** Frame-derived VDIS: smooth global translation, preserving slow pans.
+ * Input is a tiny luminance image; full camera images are never retained here.
+ */
+public final class Note5MotionFilter {
+    public static final int WIDTH = 160, HEIGHT = 90;
+    public static final float CROP = 0.84f;
+    private byte[] previous;
+    private long previousTime;
+    private double pathX, pathY, smoothX, smoothY;
+    private final double[] dx = new double[9], dy = new double[9];
+    private float offsetX, offsetY;
+    private int matched;
+
+    public void reset() {
+        previous = null;
+        previousTime = 0;
+        pathX = pathY = smoothX = smoothY = 0;
+        offsetX = offsetY = 0;
+        matched = 0;
+    }
+
+    public void update(byte[] frame, long timestamp) {
+        if (frame.length != WIDTH * HEIGHT) throw new IllegalArgumentException("luma size");
+        long delta = timestamp - previousTime;
+        if (previous == null || delta <= 0 || delta > 200_000_000L) {
+            reset(); remember(frame, timestamp); return;
+        }
+        int count = 0;
+        // A moving subject must not drive stabilization: require agreement among background tiles.
+        int[][] centers = {{30,20},{80,20},{130,20},{30,45},{80,45},{130,45},{30,70},{80,70},{130,70}};
+        for (int[] c : centers) {
+            int x = c[0], y = c[1];
+            int sum = 0, square = 0;
+            for (int yy=-5; yy<=5; yy++) for (int xx=-5; xx<=5; xx++) {
+                int value = previous[(y+yy)*WIDTH+x+xx] & 255;
+                sum += value; square += value*value;
+            }
+            if (square / 121.0 - Math.pow(sum / 121.0, 2) < 60) continue;
+            double best = Double.MAX_VALUE, runner = Double.MAX_VALUE;
+            int bestX=0, bestY=0;
+            for (int sy=-6; sy<=6; sy++) for (int sx=-6; sx<=6; sx++) {
+                double error=score(previous,frame,x,y,sx,sy);
+                if (error < best) { runner=best; best=error; bestX=sx; bestY=sy; }
+                else if (error < runner) runner=error;
+            }
+            // Reject scene cuts, ambiguous matches and motion beyond our search window.
+            if (best > 30 || runner-best < 0.35 || Math.abs(bestX)==6 || Math.abs(bestY)==6)
+                continue;
+            double[] fine=refine(previous,frame,x,y,bestX,bestY);
+            dx[count]=bestX+fine[0];dy[count]=bestY+fine[1];
+            count++;
+        }
+        double mx=0,my=0;
+        matched=0;
+        if (count>=3) {
+            double[] sortedX=Arrays.copyOf(dx,count),sortedY=Arrays.copyOf(dy,count);
+            Arrays.sort(sortedX);Arrays.sort(sortedY);
+            double medianX=sortedX[count/2],medianY=sortedY[count/2];
+            for(int i=0;i<count;i++)
+                if(Math.abs(dx[i]-medianX)<=1 && Math.abs(dy[i]-medianY)<=1) matched++;
+            if(matched>=3) { mx=medianX;my=medianY; }
+        }
+        // Ignore subpixel estimator noise; OIS already handles these tiny movements.
+        if(Math.abs(mx)<0.08) mx=0;
+        if(Math.abs(my)<0.08) my=0;
+        // Keep the same trajectory when confidence falls. Resetting it before
+        // reacquisition would make the crop jump back toward the center.
+        pathX+=mx;pathY+=my;
+        double alpha=1-Math.exp(-delta/220_000_000.0);
+        smoothX+=alpha*(pathX-smoothX);smoothY+=alpha*(pathY-smoothY);
+        float margin=(1-CROP)/2-0.002f;
+        offsetX=clamp((float)((pathX-smoothX)/WIDTH),margin);
+        offsetY=clamp((float)((pathY-smoothY)/HEIGHT),margin);
+        // Anti-windup: a long pan cannot store a hidden correction outside the crop.
+        pathX=offsetX*WIDTH;pathY=offsetY*HEIGHT;smoothX=smoothY=0;
+        remember(frame,timestamp);
+    }
+    private static double score(byte[] previous,byte[] frame,int x,int y,int sx,int sy) {
+        // Exposure/HDR changes must not masquerade as motion.
+        int change=0;
+        for(int yy=-5;yy<=5;yy+=2) for(int xx=-5;xx<=5;xx+=2)
+            change+=(frame[(y+yy+sy)*WIDTH+x+xx+sx]&255)-(previous[(y+yy)*WIDTH+x+xx]&255);
+        double mean=change/36.0,error=0;
+        for(int yy=-5;yy<=5;yy+=2) for(int xx=-5;xx<=5;xx+=2)
+            error+=Math.abs((frame[(y+yy+sy)*WIDTH+x+xx+sx]&255)
+                    -(previous[(y+yy)*WIDTH+x+xx]&255)-mean);
+        return error/36;
+    }
+    private static double[] refine(byte[] previous,byte[] frame,int x,int y,int sx,int sy) {
+        // Small-motion least-squares refinement, rather than fitting a parabola
+        // to absolute errors (which biased fine motion toward zero).
+        double mean=0;
+        for(int yy=-5;yy<=5;yy++) for(int xx=-5;xx<=5;xx++)
+            mean+=(previous[(y+yy)*WIDTH+x+xx]&255)-(frame[(y+yy+sy)*WIDTH+x+xx+sx]&255);
+        mean/=121;
+        double axx=0,ayy=0,axy=0,bx=0,by=0;
+        for(int yy=-5;yy<=5;yy++) for(int xx=-5;xx<=5;xx++) {
+            int at=(y+yy+sy)*WIDTH+x+xx+sx;
+            double gx=((frame[at+1]&255)-(frame[at-1]&255))/2.0;
+            double gy=((frame[at+WIDTH]&255)-(frame[at-WIDTH]&255))/2.0;
+            double residual=(previous[(y+yy)*WIDTH+x+xx]&255)-(frame[at]&255)-mean;
+            axx+=gx*gx;ayy+=gy*gy;axy+=gx*gy;bx+=gx*residual;by+=gy*residual;
+        }
+        double determinant=axx*ayy-axy*axy;
+        if(determinant<100) return new double[]{0,0};
+        return new double[]{Math.max(-0.5,Math.min(0.5,(ayy*bx-axy*by)/determinant)),
+                Math.max(-0.5,Math.min(0.5,(axx*by-axy*bx)/determinant))};
+    }
+    private static float clamp(float x,float bound) { return Math.max(-bound,Math.min(bound,x)); }
+    private void remember(byte[] frame,long time) {
+        if (previous==null) previous=new byte[frame.length];
+        System.arraycopy(frame,0,previous,0,frame.length); previousTime=time;
+    }
+    public float getOffsetX() { return offsetX; }
+    public float getOffsetY() { return offsetY; }
+    public int getMatchedTiles() { return matched; }
+}
