     /**
+     * Pick a frame rate that does not trigger the Exynos high-speed path, for a cold start.
+     */
+    private fun safeColdStartFrameRate(
+        camera: Camera,
+        videoQuality: androidx.camera.video.Quality,
+        target: FrameRate,
+    ): FrameRate? {
+        val supported = camera.supportedVideoQualities[videoQuality]?.supportedFrameRates
+            ?: return null
+        return supported.filter { it.value <= FrameRate.FPS_30.value }.maxByOrNull { it.value }
+            ?: supported.minByOrNull { it.value }
+    }
+
+    /**
+     * After a cold start that was clamped to a safe frame rate, restore the remembered high-speed
+     * rate as a normal reconfigure. Waits for the primer session to actually open so the
+     * reconfigure closes and reopens the device (the reliable high-speed path).
+     */
+    private fun scheduleColdHighSpeedRestore(target: FrameRate) {
+        viewModelScope.launch {
+            val opened = withTimeoutOrNull(8_000L) {
+                var info = cameraController.cameraInfo
+                while (info == null) {
+                    delay(50)
+                    info = cameraController.cameraInfo
+                }
+                info.cameraState.asFlow().first {
+                    it.type == CameraXCameraState.Type.OPEN
+                }
+                true
+            }
+            pendingColdHighSpeedFrameRate = null
+            if (opened == null) {
+                Log.w(LOG_TAG, "Primer camera did not open; keeping safe frame rate")
+                return@launch
+            }
+            var applied = false
+            var attempts = 0
+            while (!applied && attempts < 40) {
+                applied = canRestartCamera() && updateConfiguration<CameraConfiguration.Video> {
+                    it.copy(videoFrameRate = target)
+                }
+                if (!applied) {
+                    delay(50)
+                    attempts++
+                }
+            }
+            if (!applied) {
+                Log.w(LOG_TAG, "Could not restore high-speed frame rate after cold start")
+            }
+        }
+    }
+
