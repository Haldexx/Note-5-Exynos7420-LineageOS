+        // A cold start directly into a high-speed (> 30 fps) video mode opens the first HAL
+        // session straight in the Exynos high-speed path, which starves the preview pipeline and
+        // shows a black preview. Start this first session at a safe frame rate, then restore the
+        // remembered high-speed rate as a normal reconfigure once the camera is open: that closes
+        // and reopens the device, which is the path that configures high speed reliably.
+        (cameraConfiguration as? CameraConfiguration.Video)?.let { video ->
+            val target = video.videoFrameRate
+            if (target != null && target.value > FrameRate.FPS_30.value) {
+                val safe = safeColdStartFrameRate(camera, video.videoQuality, target)
+                if (safe != null && safe != target) {
+                    cameraConfiguration = video.copy(videoFrameRate = safe)
+                    pendingColdHighSpeedFrameRate = target
+                }
+            }
+        }
+
         _cameraConfiguration.value = cameraConfiguration
 
+        pendingColdHighSpeedFrameRate?.let { scheduleColdHighSpeedRestore(it) }
+
