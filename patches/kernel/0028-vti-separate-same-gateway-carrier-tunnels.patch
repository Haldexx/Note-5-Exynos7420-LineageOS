+/* Multiple phone PDNs can share the outer endpoints but have distinct inner
+ * addresses. Decapsulation has already authenticated the SA. Select its local
+ * destination before the mandatory marked policy check below, rather than the
+ * most recently inserted VTI. Never guess between ambiguous matching addresses.
+ * A lone VTI retains the existing forwarding/wildcard behaviour.
+ */
+static bool vti_has_local_address(struct net *net, struct net_device *dev,
+				  struct sk_buff *skb, int family)
+{
+	if (family == AF_INET6)
+		return ipv6_chk_addr(net, &ipv6_hdr(skb)->daddr, dev, 1);
+	else {
+		struct in_device *in_dev = __in_dev_get_rcu(dev);
+		__be32 addr = ip_hdr(skb)->daddr;
+
+		return in_dev && inet_confirm_addr(in_dev, 0, addr, RT_SCOPE_HOST) == addr;
+	}
+}
+
+static struct ip_tunnel *vti_tunnel_lookup_rx(struct net *net, __be32 remote,
+					    __be32 local, struct sk_buff *skb,
+					    int family)
+{
+	struct vti_net *ipn = net_generic(net, vti_net_id);
+	unsigned h0 = HASH(remote), h1 = HASH(local);
+	struct ip_tunnel *heads[4], *t, *only, *address_match;
+	int bucket, count, matches;
+
+	heads[0] = rcu_dereference(ipn->tunnels_r_l[h0 ^ h1]);
+	heads[1] = rcu_dereference(ipn->tunnels_r[h0]);
+	heads[2] = rcu_dereference(ipn->tunnels_l[h1]);
+	heads[3] = rcu_dereference(ipn->tunnels_wc[0]);
+	for (bucket = 0; bucket < 4; bucket++) {
+		only = address_match = NULL;
+		count = matches = 0;
+		for (t = heads[bucket]; t; t = rcu_dereference(t->next)) {
+			if (!(t->dev->flags & IFF_UP) ||
+			    (bucket < 2 && remote != t->parms.iph.daddr) ||
+			    ((bucket == 0 || bucket == 2) && local != t->parms.iph.saddr))
+				continue;
+			only = t;
+			count++;
+			if (vti_has_local_address(net, t->dev, skb, family)) {
+				address_match = t;
+				matches++;
+			}
+		}
+		if (count == 1)
+			return only;
+		if (count > 1)
+			return matches == 1 ? address_match : ERR_PTR(-EADDRNOTAVAIL);
+	}
+	return NULL;
+}
