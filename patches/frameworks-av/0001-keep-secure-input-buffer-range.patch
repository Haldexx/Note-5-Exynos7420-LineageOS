+++ b/media/libstagefright/BufferImpl.cpp
@@ -48,17 +48,31 @@ SharedMemoryBuffer::SharedMemoryBuffer(const sp<AMessage> &format, const sp<TMem
 // SecureBuffer
 
 SecureBuffer::SecureBuffer(const sp<AMessage> &format, const void *ptr, size_t size)
-    : MediaCodecBuffer(format, new ABuffer(nullptr, size)),
-      mPointer(ptr) {
+    : SecureBuffer(format, new ABuffer(nullptr, size), ptr, nullptr) {
 }
 
 SecureBuffer::SecureBuffer(
         const sp<AMessage> &format, const sp<NativeHandle> &handle, size_t size)
-    : MediaCodecBuffer(format, new ABuffer(nullptr, size)),
-      mPointer(nullptr),
+    : SecureBuffer(format, new ABuffer(nullptr, size), nullptr, handle) {
+}
+
+SecureBuffer::SecureBuffer(
+        const sp<AMessage> &format, const sp<ABuffer> &range, const void *ptr,
+        const sp<NativeHandle> &handle)
+    : MediaCodecBuffer(format, range),
+      mRange(range),
+      mPointer(ptr),
       mHandle(handle) {
 }
 
+status_t SecureBuffer::setRange(size_t offset, size_t size) {
+    if (offset > mRange->capacity() || size > mRange->capacity() - offset) {
+        return BAD_VALUE;
+    }
+    mRange->setRange(offset, size);
+    return OK;
+}
+
 void *SecureBuffer::getDestinationPointer() {
     return (void *)(mHandle == nullptr ? mPointer : mHandle->handle());
 }
